  "keyFeatures": [
    "Events calendar powered by Google Calendar API",
    "Blog powered by GitHub Discussions",
    "Team/board member directory with officer profiles",
    "Hackathon showcase pages",
    "LeetCode Dailies (lc-dailies) integration",
    "URL shortlink system (shorter)",
    "Boardify Discord slash command for board member updates",
    "ACM Paths learning roadmap",
    "Design gallery and branding assets",
    "Deployed on Cloudflare Workers with wrangler"
  ],
  "publicApiSurface": [
    "GET /events - Events listing page",
    "GET /blog - Blog listing page",
    "GET /teams - Board member directory",
    "GET /hackathons - Hackathon showcase",
    "GET /lc-dailies - LeetCode Dailies leaderboard",
    "GET /shorter - URL shortlink redirector",
    "GET /branding - ACM branding assets page",
    "GET /boardify - Board member self-update tool",
    "GET /paths - ACM learning paths",
    "GET /feed.xml - RSS feed",
    "GET /sitemap - Site map",
    "GET /[...id=link].svg - Dynamic SVG shortlink badges"
  ]
}
